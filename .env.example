# ============================================================
# vLLM 环境变量模板
# 复制为 .env 后按需修改
# ============================================================

# ---- 基础模型标识 ----
# Hugging Face 上的 repo id（与下方 HF_MODEL_PATH 二选一，repo id 优先）
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# 本地模型路径（如果已经离线下载好了，可填 /root/.cache/huggingface/<repo>）
HF_MODEL_PATH=/root/.cache/huggingface

# 客户端调用时使用的模型别名
SERVED_MODEL_NAME=qwen2.5-7b

# ---- 网络 ----
HOST=0.0.0.0
PORT=8000
# 镜像源（国内加速可选 https://hf-mirror.com）
HF_ENDPOINT=https://huggingface.co
HF_HUB_ENABLE_HF_TRANSFER=1

# ---- 并行与显存 ----
# 张量并行卡数（1 卡模型填 1，多卡模型填 2/4...）
TENSOR_PARALLEL_SIZE=1
# 显存利用率 0~1
GPU_MEMORY_UTILIZATION=0.90

# ---- 模型上下文 ----
# 单次请求允许的最大 token 数（输入+输出）
MAX_MODEL_LEN=8192
# 数据类型：auto / float16 / bfloat16
DTYPE=auto
# KV 缓存类型：auto / fp8 / fp8_e5m2 / fp8_e4m3
KV_CACHE_DTYPE=auto
# 量化方法（空=不量化，awq / gptq / bitsandbytes / fp8）
QUANTIZATION=

# ---- 吞吐性能 ----
# 同时处理的请求数上限
MAX_NUM_SEQS=256
# 单批 token 上限
MAX_NUM_BATCHED_TOKENS=8192
# PagedAttention block 大小
BLOCK_SIZE=16
# CPU swap 大小（GB）
SWAP_SPACE=4
# 启用前缀缓存（多轮对话/系统提示词复用）
ENABLE_PREFIX_CACHING=true
# 启用 chunked prefill
ENABLE_CHUNKED_PREFILL=true

# ---- 鉴权（生产建议开启）----
VLLM_API_KEY=

# ---- 多机多卡 NCCL（一般无需修改）----
NCCL_IB_HCA_LIST=
NCCL_DEBUG=WARN
